# Apps Configuration
# NEXT_PUBLIC_API_BASE: Set to http://localhost:8080 to call the backend directly (default), or http://localhost:8000/api to route through Kong instead (needs `make kong:up` + `apps:restart`)
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Kong Configuration
# KONG_DB: Set to "postgres" to use database mode, "off" for DB-less mode (default)
KONG_DB=postgres
KONG_VERSION=3.6.1
KONG_PG_USER=kong
KONG_PG_PASSWORD=kongpass
KONG_PG_DATABASE=kong

# Kafka Configuration
KAFKA_IMAGE=apache/kafka
KAFKA_VERSION=3.8.1
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,PLAINTEXT_INTERNAL://0.0.0.0:29092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,PLAINTEXT_INTERNAL://kafka:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_INTERNAL:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
# KAFKA_CLUSTER_ID: required by KRaft mode, base64 of any 16 bytes - decodes to "REPLACE_ME_LOCAL". A single local broker never talks to another cluster, so it doesn't need to be unique; regenerate with `docker run --rm apache/kafka:3.8.1 /opt/kafka/bin/kafka-storage.sh random-uuid` if you want one.
KAFKA_CLUSTER_ID=UkVQTEFDRV9NRV9MT0NBTA
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_NAME=quickstart-events
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1
# Must be 1 on a single-broker cluster - see kafka/docker-compose.yml for why.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Consul Configuration
CONSUL_IMAGE=hashicorp/consul
CONSUL_VERSION=1.21.5
CONSUL_HTTP_PORT=8500
CONSUL_DNS_PORT=8600
CONSUL_SERVER_RPC_PORT=8300
CONSUL_BIND_INTERFACE=eth0

# Playwright Configuration
# Base URL Playwright navigates to. Playwright runs on the host network (see
# playwright/docker-compose.yml), so this should be the host-published frontend URL.
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Specmatic Configuration
SPECMATIC_STUB_PORT=9091

# Microcks Configuration
MICROCKS_PORT=9090

# ZAP Configuration
ZAP_VERSION=2.17.0

# Locust Configuration
LOCUSTIO_VERSION=2.42.2
LOCUST_IMAGE=nb-locust-mysql:2.42.2
LOCUST_WORKERS=5
LOCUST_FILE=locustfile_http.py
LOCUST_TAGS=
LOCUST_DEBUG_MODE=false

# Backend Target Configuration (apps/backend)
LOCUST_HTTP_HOST=http://backend:8080

# MySQL Configuration
LOCUST_MYSQL_VERSION=8.4.7
LOCUST_MYSQL_HOST=mysql-server
LOCUST_MYSQL_PORT=3306
LOCUST_MYSQL_USER=testuser
LOCUST_MYSQL_PASSWORD=testpassword
LOCUST_MYSQL_DATABASE=information_schema
LOCUST_MYSQL_CARTESIAN_LIMIT=10000

# Load parameters (make locust:up lets you set these from the UI too;
# make locust:test needs LOCUST_RUN_TIME set up front - it's headless)
LOCUST_USERS=10
LOCUST_SPAWN_RATE=1
LOCUST_RUN_TIME=

# Cluster Configuration (for joining existing cluster from remote PC)
LOCUST_MASTER_HOST=192.168.1.100
