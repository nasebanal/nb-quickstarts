# Naming: a variable that belongs to one module is prefixed with it - APPS_,
# KONG_, KAFKA_, KEYCLOAK_, VAULT_, PLAYWRIGHT_, SPECMATIC_, ZAP_, AGENTGATEWAY_,
# OBSERVABILITY_, LOCUST_. Settings shared by several modules have no prefix and
# sit in the Common section first.
#
# On/off: a setting that is off by default is shipped commented out (`# VAR=value`);
# "unset" = the line is commented out or absent, and removing the leading "# "
# turns it on. (`VAR=` with nothing after it is a different thing - the variable is
# set, to an empty string; only APPS_BACKEND_MYSQL_PASSWORD relies on that.)

# Common Configuration (shared by several modules)
# NASEBANAL Assurance - `make <module>:report-upload` (pytest, vitest, playwright,
# specmatic, locust, zap) sends a test run's summary there through the `nb` CLI
# (bin/report_upload.sh). NB_TOKEN is a PAT / service-account token for the
# Assurance API; leave it commented out (unset) to use the credentials from `nb auth login`
# (bin/ensure_nb_auth.sh opens the browser login if there is no session; CI needs NB_TOKEN).
# NB_BASE_URL is the Assurance *API* (not the web UI at assurance.nasebanal.com /
# localhost:3007). Production by default; in your own .env use
# http://localhost:8791 to report to a local `npm run dev` of nb-assurance-api.
# NB_TOKEN=
NB_BASE_URL=https://api.assurance.nasebanal.com
PROJECT_NAME=nb-quickstarts

# Apps Configuration
# APPS_API_BASE: Set to http://localhost:8080 to call the backend directly (default), or http://localhost:8000/api to route through Kong instead (needs `make kong:up` + `apps:restart`)
APPS_API_BASE=http://localhost:8080
# SQL client (phpMyAdmin) published by apps:up, already logged in to the database.
APPS_SQL_CLIENT_PORT=8081
# renovate: depName=phpmyadmin
APPS_PHPMYADMIN_VERSION=5.2

# MCP Inspector (started by apps:up, opened by `make apps:mcp`): its UI port,
# and the auth token it is pinned to (random per start otherwise; a fixed
# public default is fine for this local demo only).
# renovate: depName=ghcr.io/modelcontextprotocol/inspector
APPS_MCP_INSPECTOR_VERSION=2.9
APPS_MCP_INSPECTOR_PORT=6274
APPS_MCP_INSPECTOR_SANDBOX_PORT=6275
APPS_MCP_INSPECTOR_TOKEN=nb-mcp-inspector-token

# The apps module's MySQL: the database and the application login (default
# demo / demo) created when the data volume is first initialised - so changing
# them later needs `make apps:reset`. apps/backend, the SQL client, the Vault
# module and Locust's MySQL scenario all use these same values. A blank value
# falls back to the default shown here; it does NOT mean "no password".
# renovate: depName=mysql
APPS_MYSQL_VERSION=8.4
APPS_MYSQL_PORT=3306
APPS_MYSQL_DATABASE=demo
APPS_MYSQL_USER=demo
APPS_MYSQL_PASSWORD=demo
APPS_MYSQL_ROOT_PASSWORD=rootpassword

# OpenTelemetry export from apps/backend. Commented out = off (default). Remove
# the leading "# " to send traces/metrics to the observability module (needs
# `make observability:up`, then `make apps:restart`).
# APPS_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# MCP login for apps/backend's /mcp (app/mcp_oauth.py). On by default: /mcp answers
# 401 until the MCP client has logged in - Claude Code then opens the browser on
# the frontend's /mcp-authorize page, which takes the app's usual login (demo
# login, or Keycloak when KEYCLOAK_ISSUER is set). To leave /mcp open instead,
# remove the leading "# " from the line below (+ `make apps:restart`).
# APPS_MCP_AUTH_REQUIRED=false
# The addresses the MCP client and browser use (host-published, not in-network);
# only change them when the backend / frontend are reached somewhere else.
# APPS_PUBLIC_BASE_URL=http://localhost:8080
# APPS_MCP_AUTHORIZE_URL=http://localhost:5173/mcp-authorize

# The backend's own MySQL login, if it should differ from the shared
# APPS_MYSQL_USER/APPS_MYSQL_PASSWORD. Leave unset normally. Setting the
# password *empty* (APPS_BACKEND_MYSQL_PASSWORD=) takes it out of the backend's
# config entirely - the Vault scenario's before/after: it can't log in until
# Vault issues it a credential.
# APPS_BACKEND_MYSQL_USER=
# APPS_BACKEND_MYSQL_PASSWORD=

# Kong Configuration
# KONG_DB: "postgres" for database mode (default; needed for Kong Manager edits to stick), "off" for DB-less mode
KONG_DB=postgres
# renovate: depName=kong
KONG_VERSION=3.9
KONG_PG_USER=kong
KONG_PG_PASSWORD=kongpass
KONG_PG_DATABASE=kong

# Kafka Configuration
KAFKA_IMAGE=apache/kafka
# renovate: depName=apache/kafka
KAFKA_VERSION=3.9.2
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,PLAINTEXT_INTERNAL://0.0.0.0:29092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,PLAINTEXT_INTERNAL://kafka:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_INTERNAL:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
# KAFKA_CLUSTER_ID: required by KRaft mode, base64 of any 16 bytes - decodes to "REPLACE_ME_LOCAL". A single local broker never talks to another cluster, so it doesn't need to be unique; regenerate with `docker run --rm apache/kafka:3.8.1 /opt/kafka/bin/kafka-storage.sh random-uuid` if you want one.
KAFKA_CLUSTER_ID=UkVQTEFDRV9NRV9MT0NBTA
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_NAME=quickstart-events
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1
# Must be 1 on a single-broker cluster - see kafka/docker-compose.yml for why.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Keycloak Configuration
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak
# renovate: depName=quay.io/keycloak/keycloak
KEYCLOAK_VERSION=26.8
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Turns on Keycloak: apps/backend then also accepts Keycloak-issued JWTs
# (app/auth.py), and the login page gets a Demo/Keycloak toggle with sign-up.
# Commented out = off (default), only the mock POST /auth/login is available.
# To turn it on, remove the leading "# " from the line below - the address the
# *browser* logs in at (match KEYCLOAK_PORT), which is also the `iss` every
# token carries. Needs `make keycloak:up`, then `make apps:restart`. The backend
# fetches the signing keys from the in-network address instead (KEYCLOAK_JWKS_URL,
# whose default already points at keycloak:8080) - see `make keycloak:verify-apps`.
# KEYCLOAK_ISSUER=http://localhost:8180/realms/nasebanal

# Vault Configuration
VAULT_IMAGE=hashicorp/vault
# renovate: depName=hashicorp/vault
VAULT_VERSION=1.21
VAULT_PORT=8200
VAULT_ROOT_TOKEN=nb-vault-root-token

# Vault: where apps/backend asks for its MySQL credential (app/config.py) -
# a fresh, short-lived MySQL user that Vault creates on the spot (needs `make
# vault:up` + `make vault:setup-mysql`, then `make apps:restart`). Both commented
# out = off (default), the backend uses APPS_MYSQL_USER/APPS_MYSQL_PASSWORD (above).
# Remove the leading "# " from both lines to turn it on. `make vault:verify-apps`
# sets these for one backend recreate without touching this file.
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=nb-vault-root-token

# Playwright Configuration
# Base URL Playwright navigates to. Playwright runs on the host network (see
# playwright/docker-compose.yml), so this should be the host-published frontend URL.
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Specmatic Configuration
# renovate: depName=specmatic/specmatic
SPECMATIC_VERSION=2.55.2
SPECMATIC_MOCK_PORT=9091

# Locust Configuration
# renovate: depName=locustio/locust
LOCUST_VERSION=2.46.7
LOCUST_IMAGE=nb-locust-mysql:2.42.2
LOCUST_WORKERS=5
LOCUST_FILE=locustfile_http.py
LOCUST_TAGS=
LOCUST_DEBUG_MODE=false

# Backend Target Configuration (apps/backend)
LOCUST_HTTP_HOST=http://backend:8080

# MySQL Configuration
LOCUST_MYSQL_HOST=mysql-server
LOCUST_MYSQL_PORT=3306
# LOCUST_MYSQL_USER=, LOCUST_MYSQL_PASSWORD=   (optional - default to APPS_MYSQL_USER/APPS_MYSQL_PASSWORD;
#                                              set them only to aim the MySQL scenario at another database)
LOCUST_MYSQL_DATABASE=information_schema
LOCUST_MYSQL_CARTESIAN_LIMIT=10000

# Load parameters (make locust:up lets you set these from the UI too;
# make locust:load needs LOCUST_RUN_TIME set up front - it's headless)
LOCUST_USERS=10
LOCUST_SPAWN_RATE=1
LOCUST_RUN_TIME=

# Cluster Configuration (for joining existing cluster from remote PC)
LOCUST_MASTER_HOST=192.168.1.100

# ZAP Configuration
# renovate: depName=zaproxy/zap-stable
ZAP_VERSION=2.17.0

# agentgateway Configuration
# renovate: depName=cr.agentgateway.dev/agentgateway
AGENTGATEWAY_VERSION=v1.6.0
AGENTGATEWAY_PORT=8010
AGENTGATEWAY_ADMIN_PORT=15000

# Observability Configuration
# renovate: depName=otel/opentelemetry-collector-contrib
OBSERVABILITY_OTEL_COLLECTOR_VERSION=0.161.0
# renovate: depName=prom/prometheus
OBSERVABILITY_PROMETHEUS_VERSION=v3.15.0
# renovate: depName=grafana/tempo
OBSERVABILITY_TEMPO_VERSION=2.10.8
# renovate: depName=grafana/loki
OBSERVABILITY_LOKI_VERSION=3.7.8
# renovate: depName=prom/alertmanager
OBSERVABILITY_ALERTMANAGER_VERSION=v0.34.1
# renovate: depName=grafana/grafana
OBSERVABILITY_GRAFANA_VERSION=11.6.16
OBSERVABILITY_GRAFANA_PORT=3030
OBSERVABILITY_PROMETHEUS_PORT=9094
OBSERVABILITY_TEMPO_PORT=3200
OBSERVABILITY_LOKI_PORT=3100
OBSERVABILITY_ALERTMANAGER_PORT=9095
OBSERVABILITY_OTEL_GRPC_PORT=4317
OBSERVABILITY_OTEL_HTTP_PORT=4318
OBSERVABILITY_PROMETHEUS_RETENTION=7d
