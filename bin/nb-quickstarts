#!/bin/sh
# nb-quickstarts - verification toolkit for the NASEBANAL Stack
#
# Usage: nb-quickstarts <module> [<target>]
# Also runs as: nb quickstarts <module> [<target>]   (through the nb command, nb 0.15.0 or later)
#
# Commands:
#   (none)                      show the modules (same as `make`)
#   <module> <target>           e.g. nb-quickstarts kong up   =  make kong:up
#   <make args...>              anything else goes to make as is, e.g. nb-quickstarts kong:up
#   --root                      print the repository directory
#   --install [DIR]             symlink this script into DIR (default ~/.local/bin)
#   --uninstall [DIR]           remove that symlink (only a link to this script)
#   --complete [WORD...]        print the tab-completion candidates for WORD... (the last one is being typed),
#                               one per line; `nb completion` calls it for `nb quickstarts <TAB>`
#
# Options:
#   -h, --help                  show this help
#
# A thin wrapper: `<module> <target>` is turned into `<module>:<target>` (only when the first word
# is one of this repository's modules and the second is a plain word, not an option, a
# VAR=value or a name that already has a colon); everything else goes to `make -C <repository>` unchanged, so
# the Makefile stays the single source of truth and plain `make` keeps working. The
# repository is found through this script's own location, following symlinks. `make` runs
# inside the repository, so relative paths in its arguments are relative to it, not to the
# directory you called from.
set -eu

# Resolve the real path of this script (portable: no `readlink -f` on older macOS).
self=$0
while [ -L "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$dir/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")

# Layout (the same in nb, nb-secrets, nb-quickstarts and nb-prober): Usage first, then one description line, "<emoji> NASEBANAL
# <Name> - <what it does>", then Commands (a line each), Options and the lines saying where the rest is. The internal
# --complete is not listed (as `nb` leaves its own completion command out of the list), and the explanation above is for
# readers of this file and of the README. The description is the first comment line above, so `nb -h` (which reads it
# without running anything) and this text cannot differ. When the nb command runs this tool (`nb quickstarts ...`, which
# sets NB_PLUGIN_NAME) the name shown, and the name the Makefile prints in its hints (QS), is the one the user typed.
qs=nb-quickstarts
[ "${NB_PLUGIN_NAME-}" = "nb quickstarts" ] && qs="nb quickstarts"
help() {
  desc=$(sed -n '2s/^# nb-quickstarts - //p' "$self")
  text=$(sed -n '3,/^set -eu/{/^set -eu/!p;}' "$self" | sed 's/^# \{0,1\}//' |
    awk -v t="⚡ NASEBANAL Quickstarts - $desc" '
      NR == 1 && $0 == "" { next }
      /^Commands:/ && !titled { print t; print ""; titled = 1 }
      /^Options:/ { options = 1 }
      options && $0 == "" { over = 1 }
      over { next }   # not exit: the sed that feeds this would hit a broken pipe
      /^  --complete / { skip = 1; next }
      skip && /^    / { next }
      { skip = 0; print }')
  if [ "$qs" = "nb quickstarts" ]; then
    text=$(printf '%s\n' "$text" | sed -e '/^Also runs as:/d' -e 's/nb-quickstarts/nb quickstarts/g')
  fi
  # Added after the renaming: the repository's address keeps its name.
  printf '%s\n\nThe Makefile is the single source of truth: plain `make` keeps working.\nMore: https://github.com/nasebanal/nb-quickstarts\n' "$text"
}

# The real path of a symlink (following a chain of links), for --uninstall to compare with this script's own.
resolve_link() {
  l=$1
  while [ -L "$l" ]; do
    d=$(cd "$(dirname "$l")" && pwd)
    t=$(readlink "$l")
    case $t in
      /*) l=$t ;;
      *) l=$d/$t ;;
    esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$l")" 2>/dev/null && pwd)" "$(basename "$l")"
}

case ${1-} in
  -h|--help) help; exit 0 ;;
  --root) printf '%s\n' "$root"; exit 0 ;;
  --complete)
    # Candidates for the words typed so far (the last is the one being completed): the modules first, then the
    # targets of the module just typed (the Makefile's `<module>-<target>` goals, called as `<module> <target>`).
    # Prints nothing, and fails nothing, when it cannot tell: a completion must never get in the way.
    shift
    [ -f "$root/Makefile" ] && command -v make >/dev/null 2>&1 || exit 0
    mods=$(sed -n 's/^\.PHONY:[[:space:]]*//p' "$root/Makefile" | tr ' ' '\n' | grep -vx default | grep -v '^$' || true)
    if [ $# -le 1 ]; then
      printf '%s\n' "$mods" | awk -v p="${1-}" 'index($0, p) == 1'
    elif [ $# -eq 2 ] && printf '%s\n' "$mods" | grep -qx -- "$1"; then
      make -C "$root" --no-print-directory -Rrqp 2>/dev/null |
        sed -n "s/^$1-\([a-z0-9][a-z0-9_-]*\):.*/\1/p" | sort -u | awk -v p="$2" 'index($0, p) == 1'
    fi
    exit 0 ;;
  --install)
    target=${2:-$HOME/.local/bin}
    mkdir -p "$target"
    ln -sf "$self" "$target/nb-quickstarts"
    echo "Linked $target/nb-quickstarts -> $self"
    case ":$PATH:" in
      *":$target:"*) ;;
      *) echo "Note: $target is not on your PATH; add it (e.g. in ~/.zshrc): export PATH=\"$target:\$PATH\"" ;;
    esac
    exit 0 ;;
  --uninstall)
    target=${2:-$HOME/.local/bin}
    link=$target/nb-quickstarts
    # only a symlink that points to this script is removed: never a file, never another program's link
    linked=""
    [ -L "$link" ] && linked=$(resolve_link "$link")
    if [ -n "$linked" ] && [ "$linked" = "$self" ]; then
      rm "$link"
      echo "Removed $link"
    elif [ -e "$link" ] || [ -L "$link" ]; then
      echo "nb-quickstarts: $link is not a link to this script: not removed" >&2
      exit 1
    else
      echo "Nothing to remove: $link does not exist"
    fi
    exit 0 ;;
esac

[ -f "$root/Makefile" ] || { echo "nb-quickstarts: no Makefile in $root" >&2; exit 1; }
command -v make >/dev/null 2>&1 || { echo "nb-quickstarts: make is not installed" >&2; exit 1; }
# "apps up" -> "apps:up". The modules are the goals the Makefile declares .PHONY, minus "default".
if [ $# -ge 2 ]; then
  case $2 in -*|*=*|*:*) ;; *)
    if sed -n 's/^\.PHONY:[[:space:]]*//p' "$root/Makefile" | tr ' ' '\n' | grep -vx default | grep -qx -- "$1"; then
      mod=$1; target=$2; shift 2
      set -- "$mod:$target" "$@"
    fi ;;
  esac
fi
exec env QS="$qs" make -C "$root" --no-print-directory "$@"
