{
  "realm": "nasebanal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "clients": [
    {
      "clientId": "apps-demo",
      "name": "nb-quickstarts apps demo client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "keycloak-demo",
      "enabled": true,
      "emailVerified": true,
      "email": "keycloak-demo@example.com",
      "firstName": "Keycloak",
      "lastName": "Demo",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "nasebanal-demo",
          "temporary": false
        }
      ]
    }
  ],
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600
}
