#################### ENVIRONMENT SETUP ###################

ifneq (,$(wildcard ../.env))
    include ../.env
    export
endif

#################### SPECMATIC (contract test against the running backend) ###################

specmatic:
	@echo "🚀 Specmatic"
	@echo "Specmatic - OpenAPI-driven contract testing. Test the running backend against the checked-in shared contract, and mock that same contract for consumer-side testing."
	@echo ""
	@echo "Test Commands (Provider - does the backend honor the shared contract?):"
	@echo "  specmatic:test - Contract-test the running backend against shared/openapi/openapi.yaml + examples"
	@echo ""
	@echo "Container Management (Consumer - mock the contract for apps/frontend to test against):"
	@echo "  specmatic:mock-up   - Start a mock server built from the same contract + examples"
	@echo "  specmatic:mock-down - Stop and remove it"
	@echo ""
	@echo "Configuration (.env file):"
	@echo "  SPECMATIC_MOCK_PORT=9091 # Mock server port"
	@echo ""
	@echo "Endpoints once started:"
	@echo "  Mock server: http://localhost:$${SPECMATIC_MOCK_PORT:-9091}"
	@echo ""
	@echo "Note: specmatic:test requires apps to be running first - make apps:up. The mock does not."
	@echo ""
	@echo "Report: specmatic/report/test/html/index.html (also specmatic/junit/TEST-junit-jupiter.xml)"
	@echo ""
	@echo "  specmatic:report - Open that report in your browser"
	@echo "  specmatic:reset  - Delete the generated report and JUnit output (specmatic/report/, specmatic/junit/)"

specmatic\:%:
	@$(MAKE) specmatic-$(subst specmatic:,,$@)

#################### SPECMATIC ACTIONS ###################

specmatic-test: apps-network-ensure
	@bin/run_test.sh specmatic specmatic:report -- \
		docker compose -p specmatic -f specmatic/docker-compose.yml run --rm --name nb-specmatic-$$(openssl rand -hex 3) specmatic

# specmatic/report/test/html/index.html (the one specmatic-test itself
# produces) is a single self-contained file, unlike specmatic/report/html -
# a separate, unrelated report with its own assets/ directory - opens fine
# via file://.
specmatic-report:
	@if [ ! -f specmatic/report/test/html/index.html ]; then \
		echo "No report yet - run 'make specmatic:test' first."; \
		exit 1; \
	fi
	@bin/open_browser.sh specmatic/report/test/html/index.html

# Empties the generated report and JUnit output (gitignored, regenerated by
# specmatic:test); the directories themselves stay. Doesn't touch the mock.
specmatic-reset:
	@find specmatic/report specmatic/junit -mindepth 1 -delete 2>/dev/null; true
	@echo "Specmatic report and JUnit output removed (specmatic/report/, specmatic/junit/)."

specmatic-mock-up: apps-network-ensure
	@echo "Starting Specmatic mock (mock server built from shared/openapi/openapi.yaml + examples)..."
	@docker compose -p specmatic -f specmatic/docker-compose.yml up -d --build specmatic-mock
	@echo "Mock server: http://localhost:$${SPECMATIC_MOCK_PORT:-9091}"

specmatic-mock-down:
	@echo "Stopping Specmatic mock..."
	@docker compose -p specmatic -f specmatic/docker-compose.yml rm -f -s specmatic-mock
	@echo "Specmatic mock stopped and removed."
