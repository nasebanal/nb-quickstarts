#################### ENVIRONMENT SETUP ###################

ifneq (,$(wildcard ../.env))
    include ../.env
    export
endif

#################### VITEST (apps/frontend unit tests) ###################
# vitest:test mocks `fetch`, so `make apps:up` is not required.
# vitest:contract-test is different - see below.

vitest:
	@echo "🚀 Vitest"
	@echo "Vitest - a Vite-native unit-testing framework for JavaScript/TypeScript. Here running apps/frontend's test suite."
	@echo ""
	@echo "Test Commands:"
	@echo "  vitest:test          - Build (if needed) and run apps/frontend unit tests"
	@echo "  vitest:contract-test - Run apps/frontend's src/lib/contract/ suite against a"
	@echo "                         Specmatic mock instead of a mocked fetch - a Consumer-"
	@echo "                         side contract test (does the frontend's own API usage"
	@echo "                         hold up against apps/backend/openapi.yaml, independent"
	@echo "                         of the real backend's current behavior?)"
	@echo ""
	@echo "Note: vitest:test mocks fetch entirely; apps:up is NOT required."
	@echo "      vitest:contract-test instead needs a running mock -"
	@echo "      make apps:up && make specmatic:mock-up first."
	@echo ""
	@echo "Report: vitest/report/index.html (vitest:test),"
	@echo "        vitest/report-contract/index.html (vitest:contract-test)"
	@echo ""
	@echo "  vitest:report          - Serve + open vitest/report/index.html (Ctrl+C to stop serving)"
	@echo "  vitest:report-contract - Same, for vitest/report-contract/index.html"
	@echo "  vitest:reset           - Delete both generated reports (vitest/report/, vitest/report-contract/)"

vitest\:%:
	@$(MAKE) vitest-$(subst vitest:,,$@)

#################### VITEST ACTIONS ###################

vitest-test:
	@bin/run_test.sh vitest vitest:report -- \
		docker compose -p vitest -f vitest/docker-compose.yml run --build --rm --name nb-vitest-$$(openssl rand -hex 3) vitest

vitest-contract-test: apps-network-ensure
	@bin/run_test.sh vitest-contract vitest:report-contract -- \
		docker compose -p vitest -f vitest/docker-compose.yml run --build --rm --name nb-vitest-contract-$$(openssl rand -hex 3) vitest-contract

# Empties both report directories (gitignored, regenerated by the matching
# test target); the directories themselves stay.
vitest-reset:
	@find vitest/report vitest/report-contract -mindepth 1 -delete 2>/dev/null; true
	@echo "Vitest reports removed (vitest/report/, vitest/report-contract/)."

# Unlike pytest's/specmatic's single self-contained file, Vitest's own html
# reporter ships a small SPA (report/ui/assets/*.js) that fetches
# report/ui/html.meta.json.gz by a relative path at runtime - browsers block
# fetch() against file:// URLs entirely, so opening index.html directly
# leaves the page blank. A trivial local static server sidesteps that same
# way `npx playwright show-report` does for Playwright below. Runs in the
# foreground (like that command) - Ctrl+C stops it; nothing is left running.
vitest-report:
	@$(MAKE) _vitest-serve-report DIR=vitest/report PORT=$${VITEST_REPORT_PORT:-4173}

vitest-report-contract:
	@$(MAKE) _vitest-serve-report DIR=vitest/report-contract PORT=$${VITEST_REPORT_CONTRACT_PORT:-4174}

_vitest-serve-report:
	@if [ ! -f $(DIR)/index.html ]; then \
		echo "No report yet in $(DIR) - run the matching vitest:test first."; \
		exit 1; \
	fi
	@echo "Serving $(DIR) at http://localhost:$(PORT) (Ctrl+C to stop)..."
	@(sleep 1 && bin/open_browser.sh http://localhost:$(PORT)) &
	@python3 -m http.server $(PORT) --directory $(DIR)
